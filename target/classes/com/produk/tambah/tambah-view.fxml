<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.produk.tambah.TambahController"
    stylesheets="@tambah-style.css"
    styleClass="root-bg">

    <center>
        <VBox alignment="TOP_CENTER" spacing="25">

            <Label
                text="Tambah Produk Baru"
                styleClass="title-label"/>

            <VBox
                spacing="18"
                styleClass="form-card"
                maxWidth="650">

                <padding>
                    <Insets top="35" right="40" bottom="35" left="40"/>
                </padding>

                <VBox spacing="8">
                    <Label text="Nama Produk" styleClass="label-form"/>
                    <TextField
                        fx:id="txtNama"
                        promptText="Masukkan nama produk"
                        styleClass="input-field"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Harga" styleClass="label-form"/>
                    <TextField
                        fx:id="txtHarga"
                        promptText="Masukkan harga"
                        styleClass="input-field"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Stok" styleClass="label-form"/>
                    <TextField
                        fx:id="txtStok"
                        promptText="Masukkan stok"
                        styleClass="input-field"/>
                </VBox>

                <HBox
                    spacing="15"
                    alignment="CENTER_RIGHT">

                    <Button
                        text="Batal"
                        styleClass="btn-batal"/>

                    <Button
                        text="Simpan"
                        onAction="#onTambahClick"
                        styleClass="btn-simpan"/>
                </HBox>

            </VBox>

            </VBox>
    </center>

</BorderPane>