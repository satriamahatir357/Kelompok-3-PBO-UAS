<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="25.0" prefHeight="400.0" prefWidth="600.0" 
      style="-fx-background-color: #1e3495;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      
      <!-- Judul Aplikasi Saat Loading -->
      <Label text="SISTEM MANAJEMEN PRODUK" textFill="WHITE">
         <font>
            <Font name="Segoe UI Bold" size="28.0" />
         </font>
      </Label>
      
      <!-- Animasi Lingkaran Muter (Warna Putih) -->
      <ProgressIndicator prefHeight="65.0" prefWidth="65.0" style="-fx-progress-color: #ffffff;" />
      
      <!-- Teks Status Keterangan -->
      <Label text="Memuat komponen aplikasi, mohon tunggu..." textFill="#dddddd">
         <font>
            <Font name="Segoe UI Italic" size="14.0" />
         </font>
      </Label>
      
   </children>
</VBox>