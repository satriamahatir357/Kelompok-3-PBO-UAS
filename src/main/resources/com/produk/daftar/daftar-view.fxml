<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="24"
      stylesheets="@daftar-style.css"
      styleClass="daftar-page"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.produk.daftar.DaftarController">

    <Label text="Daftar Produk Lengkap" styleClass="title"/>

    <VBox styleClass="table-box" VBox.vgrow="ALWAYS" maxWidth="Infinity">
        
        <HBox styleClass="table-header" spacing="8">
            <Label text="Daftar Produk" styleClass="table-title"/>
            
            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="txtSearch" promptText="Search" styleClass="search-field"/>

            <ComboBox fx:id="cmbUrutkan" promptText="Urutkan" styleClass="sort-box">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="A-Z"/>
                        <String fx:value="Z-A"/>
                        <String fx:value="Harga Termurah"/>
                        <String fx:value="Harga Termahal"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </HBox>

        <TableView fx:id="tableProduk" styleClass="produk-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNomor" text="Nomor" prefWidth="50"/>
                <TableColumn fx:id="colNama" text="Nama Produk" prefWidth="180"/>
                <TableColumn fx:id="colHarga" text="Harga(Rp)" prefWidth="120"/>
                <TableColumn fx:id="colStok" text="Stok" prefWidth="80"/>
                <TableColumn fx:id="colDiskon" text="Diskon" prefWidth="180"/>
                <TableColumn fx:id="colAksi" text="Aksi" prefWidth="150"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </VBox>
</VBox>