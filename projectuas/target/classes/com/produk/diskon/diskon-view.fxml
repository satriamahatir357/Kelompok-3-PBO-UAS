<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" stylesheets="@diskon-style.css" styleClass="diskon-main-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.produk.diskon.DiskonController">
    
    <Label text="Kalkulator Diskon Produk" styleClass="halaman-title"/>
    
    <VBox spacing="10.0" styleClass="form-container">
        <Label text="Harga Asli (Rp):" styleClass="input-label"/>
        <TextField fx:id="txtHargaAsli" promptText="Contoh: 50000" styleClass="input-field"/>
        
        <Label text="Diskon (%):" styleClass="input-label"/>
        <TextField fx:id="txtPersenDiskon" promptText="Contoh: 10" styleClass="input-field"/>
        
        <Button text="Hitung Harga Akhir" onAction="#onHitungClick" styleClass="btn-hitung"/>
    </VBox>

    <VBox spacing="5.0" styleClass="hasil-container">
        <Label text="Harga Setelah Diskon:" styleClass="label-hasil-text"/>
        <Label fx:id="lblHargaAkhir" text="Rp 0" styleClass="label-hasil-angka"/>
    </VBox>
    
</VBox>